@model RepuestoForm
@{ ViewData["Title"] = Model.IdRepuesto == 0 ? "Nuevo repuesto" : "Editar repuesto"; }
<div class="page-heading"><div><a asp-action="Index" class="back"><i data-lucide="arrow-left"></i> Catalogo</a><h1>@ViewData["Title"]</h1></div></div>
<form method="post" class="editor">
    <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
    <input asp-for="IdRepuesto" type="hidden" />
    <div class="form-grid">
        <div class="field"><label for="Codigo">Codigo</label><output id="Codigo" class="generated-code">@(Model.IdRepuesto == 0 ? "Pendiente" : Model.Codigo)</output></div>
        <div class="field"><label asp-for="IdCategoria"></label><select asp-for="IdCategoria"><option value="">Seleccionar</option>@foreach (var item in Model.Categorias) { <option value="@item.Id">@item.Nombre</option> }</select><span asp-validation-for="IdCategoria" class="validation"></span></div>
        <div class="field full"><label asp-for="Nombre"></label><input asp-for="Nombre" /><span asp-validation-for="Nombre" class="validation"></span></div>
        <div class="field"><label asp-for="PrecioVenta"></label><input asp-for="PrecioVenta" type="number" step="0.01" min="0" max="99999999.99" /><span asp-validation-for="PrecioVenta" class="validation"></span></div>
        <div class="field"><label asp-for="Costo"></label><input asp-for="Costo" type="number" step="0.01" min="0" max="99999999.99" /><span asp-validation-for="Costo" class="validation"></span></div>
        <label class="check"><input asp-for="Activo" /> Activo</label>
    </div>
    <div class="form-actions"><a asp-action="Index" class="button">Cancelar</a><button class="primary"><i data-lucide="save"></i> Guardar repuesto</button></div>
</form>
